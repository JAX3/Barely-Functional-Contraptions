{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "barelyfunctionalcontraptions:block/wool_lined_crate",
        "y": 0
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "barelyfunctionalcontraptions:block/wool_lined_crate",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "barelyfunctionalcontraptions:block/wool_lined_crate",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "barelyfunctionalcontraptions:block/wool_lined_crate",
        "y": 270
      }
    },
    {
